# Local development — copy to .env
DATABASE_URL=postgres://postgres@localhost:5432/guest_dev
# Dev-only JWT signing secret. Real deployments must set a strong value.
JWT_SECRET=dev-secret-change-me
PORT=3001

# The API connects as unprivileged roles so RLS actually applies
# (db/migrations/003_rls.sql). Locally these are derived from DATABASE_URL
# with dev passwords; in production set each explicitly and give the
# superuser URL to migrations only.
# DATABASE_URL_APP_RW=postgres://app_rw:...@host:5432/guest
# DATABASE_URL_APP_USHER=postgres://app_usher:...@host:5432/guest
# DATABASE_URL_APP_PUBLIC=postgres://app_public:...@host:5432/guest
# DATABASE_URL_APP_VERIFY=postgres://app_verify:...@host:5432/guest
# DATABASE_URL_APP_BILLING=postgres://app_billing:...@host:5432/guest
#
# The sixth role is the exception — the platform admin dashboard is not the
# gate, so its pool is built on first use. Unset, everything else works and
# only /admin answers 503 platform_not_configured.
# DATABASE_URL_APP_ADMIN=postgres://app_admin:...@host:5432/guest
#
# In production the first five are REQUIRED: the API refuses to start
# rather than fall back to the dev passwords, which are in the repo.
# Deployment is written up in DEPLOY.md.

# Who is allowed to tell the API the caller's real address.
#
# Leave it UNSET locally. Nothing proxies to a local API, so trusting
# X-Forwarded-For here would just let anything claim any address.
#
# In production it is effectively required, and the reason is not obvious:
# nothing reaches the API directly. The platform's router sits in front of
# it, and the web app makes every guest-facing call server-side. Unset,
# req.ip is therefore that router or that web app for EVERY request — so
# all the per-IP rate limits share one bucket, and the first burst locks
# out the whole internet including the couple. The API says so loudly at
# startup rather than letting you find out from a customer.
#
#   TRUST_PROXY=10.0.0.0/8   best — only these addresses may set the header
#   TRUST_PROXY=2            believe the last 2 hops (router, then web app)
#   TRUST_PROXY=true         believe the whole chain; fine when the API is
#                            reachable only through the router
#
# DEPLOY.md §6 has the whole picture, including why the per-phone limits
# carry the real weight regardless of what this is set to.
# TRUST_PROXY=

# SMS (OTP login). Unset locally: codes go to the server log and come back
# in the response as dev_code. Setting TERMII_API_KEY switches to real
# delivery AND stops dev_code being returned at all — the API is the only
# place that decides this, never the client.
#
# SMS_SENDER_ID must be registered with Termii before it will send. Their
# pre-approved "N-Alert" works from day one and reaches DND numbers.
# Leave SMS_CHANNEL alone: most Nigerian numbers are on the Do-Not-Disturb
# list, and the generic route reports success and delivers nothing.
# TERMII_API_KEY=
# SMS_SENDER_ID=N-Alert
# SMS_CHANNEL=dnd
#
# SMS is optional. Organisers sign up and sign in with a password and
# recover with a code; ushers arrive by an invite link shared over
# WhatsApp. OTP login is one extra door, not the only one.
#
# Set this to run production with no messaging provider at all. Any OTP
# codes then go to the server log in clear text (never to an HTTP
# response), and it says so loudly at startup.
# ALLOW_SMS_LOG_SENDER=true

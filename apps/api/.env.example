# Local development — copy to .env
DATABASE_URL=postgres://postgres@localhost:5432/guest_dev
# Dev-only JWT signing secret. Real deployments must set a strong value.
JWT_SECRET=dev-secret-change-me
PORT=3001

# The API connects as unprivileged roles so RLS actually applies
# (db/migrations/003_rls.sql). Locally these are derived from DATABASE_URL
# with dev passwords; in production set each explicitly and give the
# superuser URL to migrations only.
# DATABASE_URL_APP_RW=postgres://app_rw:...@host:5432/guest
# DATABASE_URL_APP_USHER=postgres://app_usher:...@host:5432/guest
# DATABASE_URL_APP_PUBLIC=postgres://app_public:...@host:5432/guest
# DATABASE_URL_APP_VERIFY=postgres://app_verify:...@host:5432/guest
# DATABASE_URL_APP_BILLING=postgres://app_billing:...@host:5432/guest
#
# In production every one of these is REQUIRED: the API refuses to start
# rather than fall back to the dev passwords, which are in the repo.
# Deployment is written up in DEPLOY.md.

# SMS (OTP login). Unset locally: codes go to the server log and come back
# in the response as dev_code. Setting TERMII_API_KEY switches to real
# delivery AND stops dev_code being returned at all — the API is the only
# place that decides this, never the client.
#
# SMS_SENDER_ID must be registered with Termii before it will send. Their
# pre-approved "N-Alert" works from day one and reaches DND numbers.
# Leave SMS_CHANNEL alone: most Nigerian numbers are on the Do-Not-Disturb
# list, and the generic route reports success and delivers nothing.
# TERMII_API_KEY=
# SMS_SENDER_ID=N-Alert
# SMS_CHANNEL=dnd
